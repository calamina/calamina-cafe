<div class="sequence">
  <div class="window">
    <div class="legend">60fps</div>
    <div class="content">
      <p class="drawing sixty"></p>
    </div>
  </div>

  <div class="window">
    <div class=" legend">24fps</div>
    <div class="content">
      <p class="drawing twentyfour"></p>
    </div>
  </div>

  <div class="window">
