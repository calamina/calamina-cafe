<script>
  const configs = {
    Classic: { fps: "ones", preview: "preview-ones" },
    Twos: { fps: "twos", preview: "preview-twos" },
    Threes: { fps: "threes", preview: "preview-threes" },
    Fours: { fps: "fours", preview: "preview-fours" },
  };

  const buttons = document.querySelectorAll(".controls button");
  const fpsEl = document.querySelector(".fps");
  const previewEl = document.querySelector(".preview");

  buttons.forEach((button) =>
    button.addEventListener("click", () =>
      setActive(button as HTMLButtonElement),
    ),
  );

  const setActive = (button: HTMLButtonElement) => {
    buttons.forEach((b) => b.classList.remove("active"));
    button.classList.add("active");

    const text = button.textContent.trim() as keyof typeof configs;
    const config = configs[text];

    if (config && fpsEl && previewEl) {
      fpsEl.className = `fps ${config.fps}`;
      previewEl.className = `preview ${config.preview}`;
    }
  };
</script>

<div class="wrapper">
  <div class="element">
    <div class="fps ones">
      <span></span><span></span><span></span><span></span><span></span><span
      ></span><span></span><span></span><span></span><span></span><span
      ></span><span></span><span></span><span></span><span></span><span
      ></span><span></span><span></span><span></span><span></span><span
      ></span><span></span><span></span><span></span>
    </div>
    <div class="preview preview-ones">
      <span></span>
    </div>
  </div>
  <div class="controls">
    <button class="active">Classic</button>
    <button>Twos</button>
    <button>Threes</button>
    <button>Fours</button>
  </div>
</div>

<style>
