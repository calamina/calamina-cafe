    --i: calc(round(down, (sibling-index() - 1) / 2, 1) * 30deg);
  }

  .threes span {
    --i: calc(round(down, (sibling-index() - 1) / 3, 1) * 45deg);
  }

  .fours span {
    --i: calc(round(down, (sibling-index() - 1) / 4, 1) * 60deg);
  }

  .ones span,
  .twos span:nth-child(odd),
  .threes span:nth-child(3n + 1),
  .fours span:nth-child(4n + 1) {
    opacity: 1;
    border-color: var(--bg-alter);

    &:after {
      background-color: var(--highlight);
    }
  }

  .preview {
    display: grid;
