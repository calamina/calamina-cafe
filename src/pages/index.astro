---
import TitleDisplay from "@components/atomic/TitleDisplay.astro";
import LatestList from "@components/features/latest/latestList.astro";
import { description } from "@data/description";
import MainLayout from "@layouts/MainLayout.astro";
---

<script>
  import { useAscii } from "@utils/ascii";
  useAscii();

  const goElement = document.querySelector(".go");
  const links = document.querySelectorAll("a");

  links.forEach((link) => {
    link.addEventListener("mouseenter", () => {
      goElement?.classList.add("active-cta");
      goElement?.classList.remove("inactive-cta");
    });
    link.addEventListener("mouseleave", () => {
      goElement?.classList.add("inactive-cta");
      goElement?.classList.remove("active-cta");
    });
  });
</script>

<MainLayout description={description.home}>
  <div id="container"></div>
  <div class="core">
    <TitleDisplay />
    <div class="cta">
      <!-- add coordinates ? -->
      <!-- replace with log like journal ? -->
      <span class="move">.: move :.</span>
      <span class="click">:: click ::</span>
      <span class="go">·: go :·</span>
    </div>
    <div class="bottom">
      <LatestList />
      <div class="description">
        <p>
          <span class="ball"></span>Personnal website of developper <span
            >Grégoire Belliere</span
          >
        </p>
        <!-- <p>Forever <span class="state">human made</span> &</p> -->
      </div>
    </div>
  </div>
</MainLayout>

<style>
  #container {
    position: fixed;
    z-index: -1;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100svh;
  }

  .core {
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-rows: 0.75fr 1fr 1fr;
    height: calc(100svh - 6rem);
    gap: 0;
    width: 100%;
    place-items: center;
    padding: 0 0 3rem;

    @media (max-width: 1280px) {
      grid-template-rows: 0.3fr 1fr 1fr;
      height: calc(100svh - 8rem);
      padding: 0;
    }
  }

  .cta {
    position: absolute;
    display: flex;
    flex-flow: column;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: calc(100svh - 16rem);
    top: 8rem;
    gap: 0.5rem;
    /* padding-bottom: 6rem; */
  }

  .cta span {
    border-radius: var(--radius-sm);
    color: var(--color-alt);
    text-align: center;
    opacity: 0.3;

    /* width: 6ch; */

    &::before {
      position: absolute;
      left: -2ch;
      /* content: ".:"; */
    }
    &::after {
      position: absolute;
      right: -2ch;
      /* content: ":."; */
    }
  }

  .active-cta {
    animation: activate 0.125s;
    animation-fill-mode: both;
    opacity: 1;
    color: var(--color);
    background-color: var(--highlight);
  }

  .inactive-cta {
    animation-fill-mode: both;
    animation: deactivate 0.3s;
    opacity: 0.3;
    color: var(--color-alt);
    background-color: transparent;
  }

  .bottom {
    width: 100%;
    grid-row: 3;
    align-self: end;
    display: flex;
    align-items: end;
    justify-content: space-between;
    height: fit-content;

    @media (max-width: 1280px) {
      padding: 0 0 1rem;
      left: 3rem;
      right: 3rem;
      bottom: 0;
      display: flex;
      flex-flow: column;
      align-items: start;
      gap: 4rem;
    }
  }

  .description {
    display: flex;
    flex-flow: column;
    align-items: end;
    text-wrap: balance;
    width: fit-content;

    @media (max-width: 1280px) {
      gap: 0.5rem;

      span,
      p {
        flex-wrap: wrap;
        line-height: 0.6rem;
        letter-spacing: -0.5px;
        font-size: 0.8rem;
      }
    }

    p {
      line-height: 1.25rem;
      color: var(--color-alter);

      &:first-of-type {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;

        .ball {
          background-color: var(--highlight);
          height: 0.45rem;
          width: 0.45rem;
          flex-shrink: 0;
          border-radius: var(--radius-md);
        }
      }
    }
  }

  .state {
    display: inline-block;
    width: 10ch;

    @media (max-width: 1280px) {
      width: 9.5ch;
    }
  }

  @keyframes activate {
    0% {
      opacity: 0.3;
      color: var(--color-alt);
      transition: all 0.5 ease-out;
    }
    100% {
      opacity: 1;
      color: var(--color);
      background-color: var(--highlight);
    }
  }
  @keyframes deactivate {
    100% {
      opacity: 0.3;
      color: var(--color-alt);
      transition: all 0.5 ease-out;
    }
    0% {
      opacity: 1;
      color: var(--color);
      background-color: var(--highlight);
    }
  }
</style>
