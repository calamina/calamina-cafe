---
import TitleDisplay from "@components/atomic/TitleDisplay.astro";
import LatestList from "@components/features/latest/latestList.astro";
import { description } from "@data/description";
import MainLayout from "@layouts/MainLayout.astro";
---

<script>
  import { useAscii } from "@utils/ascii";
  useAscii();
</script>

<MainLayout description={description.home}>
  <div id="container"></div>
  <div class="core">
    <TitleDisplay />
    <div class="bottom">
      <LatestList />
      <p class="description">
        <span class="ball"></span>
        <span class="gem-message">Catch that cube please ...</span>
      </p>
    </div>
  </div>
</MainLayout>

<style>
  #container {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100svh;
  }

  .core {
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-rows: 0.75fr 1fr 1fr;
    height: calc(100svh - 6rem);
    gap: 0;
    width: 100%;
    place-items: center;
    padding: 0 0 3rem;

    @media (max-width: 1280px) {
      grid-template-rows: 0.3fr 1fr 1fr;
      height: calc(100svh - 8rem);
      padding: 0;
    }
  }

  .bottom {
    width: 100%;
    grid-row: 3;
    align-self: end;
    display: flex;
    align-items: end;
    justify-content: space-between;
    height: fit-content;

    @media (max-width: 1280px) {
      padding: 0 0 1rem;
      left: 3rem;
      right: 3rem;
      bottom: 0;
      display: flex;
      flex-flow: column;
      align-items: start;
      gap: 2rem;
    }
  }

  .description {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    width: fit-content;
    background-color: var(--bg-alt);
    padding: 0.1rem 0.75rem 0.2rem;

    @media (max-width: 1280px) {
      gap: 0.5rem;
      padding: 0.1rem 0.75rem 0rem;
    }

    .gem-message {
      color: var(--color-alt);
    }

    .ball {
      background-color: var(--color-alter);
      height: 0.45rem;
      width: 0.45rem;
      margin-top: 0.1rem;
      flex-shrink: 0;

      @media (max-width: 1280px) {
        margin-top: 0rem;
      }
    }
  }
</style>
